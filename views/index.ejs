<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    
    <title>Online Food Ordering Platform</title>

</head>



<body>
    <!-- REGISTRATION PAGE -->
<div id="registrationPage">

    <div class="register-box">

        <h1>🍽 FoodExpress</h1>

        <h2>Registration</h2>

        <input type="text"
               id="regName"
               placeholder="Enter Full Name">

        <input type="tel"
               id="regNumber"
               placeholder="Enter Mobile Number">

        <input type="email"
               id="regEmail"
               placeholder="Enter Email">

        <input type="password"
               id="regPassword"
               placeholder="Enter Password">

        <button type="button" onclick="registerUser()" id="registerBtn">
            Register
        </button>
        <p class="auth-switch">Already have an account? <a href="#" onclick="showLoginPage(); return false;">Login</a></p>
        <p id="registerMessage" class="form-message" role="status" aria-live="polite"></p>

    </div>

</div>

          <!-- LOGIN PAGE -->

<div id="loginPage" style="display:none;">

    <div class="overlay">

        <div class="login-box">

            <h1>🍽 FoodExpress</h1>
            <h3>Login</h3>

            <input
                type="text"
                id="fullName"
                placeholder="Enter Full Name"
            >

            <input
                type="email"
                id="email"
                placeholder="Enter Email"
                autocomplete="email"
            >
            <input
                type="password"
                id="loginPassword"
                placeholder="Enter Password"
                autocomplete="current-password"
            >
            <p id="loginMessage" class="form-message" role="status" aria-live="polite"></p>
            <p class="auth-switch">New to FoodExpress? <a href="#" onclick="showRegistrationPage(); return false;">Create an account</a></p>

            <button
                type="button"
                onclick="verifyEmail()">
                Login
            </button>


            <!-- SUCCESS MESSAGE -->

            <div
                id="successMessage"
                class="success-box"
                style="display:none;">

                <h3>✅ Email Verified Successfully</h3>

                <p>
                    Name:
                    <b id="verifiedName"></b>
                </p>

                <p>
                    Email:
                    <b id="verifiedEmail"></b>
                </p>

                <button
                    type="button"
                    onclick="showStartOrdering()">
                    OK
                </button>

            </div>


            <!-- START ORDERING BUTTON -->

            <button
                id="startBtn"
                type="button"
                onclick="startWebsite()"
                style="display:none;">

                Start Ordering

            </button>

        </div>

    </div>

</div>


          


  <!-- Website -->

       
<div id="website" style="display:none;">


    <header>

        <div class="type">

            <i class="fa-solid fa-utensils"></i>

            <h2>FoodExpress</h2>

        </div>
        <nav>
           <ul>

                <li><a href="#home">Home</a></li>

                <li><a href="#menu" onclick="showAllMenu()"> Menu </a></li>

             <li><a href="#about">About</a></li>

                <li><a href="#contact">Contact</a></li>
<li class="user-area">

    <i class="fa-solid fa-circle-user"
       onclick="showProfile()"
       style="color:#2b6cff;font-size:28px;cursor:pointer;">
    </i>

    <span id="welcomeUser"></span>

    <button class="logout-btn" onclick="logoutUser()">
        Logout
    </button>

</li>
            </ul>

        </nav>


    </header>


<!-- HERO / OFFERS SECTION -->
 <section class="hero" id="home">
    <!-- OFFER HEADING -->
<div class="offer-heading-box">
    <h2>🔥 Special Offers For You</h2>

